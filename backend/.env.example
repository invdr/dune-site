# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/web_app_demo?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/web_app_demo_test?schema=public"

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:19006"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
COOKIE_SECURE="false"

# Public self-registration (POST /api/auth/register). Keep "false" in
# production so nobody who finds the endpoint can claim an admin account. Flip
# to "true" only briefly to create a new staff user, then set it back.
REGISTRATION_ENABLED="false"

# Media storage. Two interchangeable backends; configure ONE.
#
# 1) Local disk (single-VPS): files are written under MEDIA_LOCAL_ROOT and
#    served by nginx from MEDIA_PUBLIC_BASE_URL. Set both to enable. Example:
#      MEDIA_LOCAL_ROOT="/opt/dune/media"
#      MEDIA_PUBLIC_BASE_URL="https://dunestate.ru/media"
MEDIA_LOCAL_ROOT=""
MEDIA_PUBLIC_BASE_URL=""
#
# 2) S3-compatible object storage (Yandex Object Storage, DigitalOcean Spaces,
#    MinIO, ...). The SPACES_ prefix is legacy naming; any S3 endpoint works.
#    Set SPACES_CDN_BASE_URL to the public/CDN base for correct object URLs.
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_ENDPOINT=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_UPLOAD_MAX_BYTES="10485760"
SPACES_UPLOAD_URL_TTL_SECONDS="900"
SPACES_DOWNLOAD_URL_TTL_SECONDS="300"
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"
