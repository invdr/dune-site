# Website (Astro) environment.
# PUBLIC_ vars are inlined into client bundles AND readable in SSR frontmatter.

# Backend API base URL the storefront reads listings/leads/content from.
# Local development default is the backend dev server.
PUBLIC_API_URL="http://localhost:3000"

# Absolute site origin used for canonical URLs and Open Graph/Twitter tags.
PUBLIC_SITE_URL="https://dunestate.ru"
