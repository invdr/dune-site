---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getPublicSettings, listProperties } from '../lib/api'
import { cardHtml } from '../lib/card'
import { PROPERTY_TYPES } from '../lib/directions'
import {
  activePills,
  headFor,
  parseState,
  priceCurrency,
  priceEnabled,
  toQuery,
} from '../lib/catalogState'

const state = parseState(Astro.url.searchParams)
const head = headFor(state)
const settings = await getPublicSettings()
const result = await listProperties(toQuery(state, 1))

const gridHtml = result.items.map((p) => cardHtml(p)).join('')
const pills = activePills(state)
const priceOn = priceEnabled(state)
const priceCur = priceCurrency(state) === 'USD' ? '$' : '₽'
const hasMore = result.pageCount > 1

const dirChips = [
  { key: 'new', label: 'Новостройки' },
  { key: 'resale', label: 'Вторичка' },
  { key: 'dubai', label: 'Дубай' },
  { key: 'saudi', label: 'KSA' },
]
const roomChips = [
  { value: 0, label: 'Студия' },
  { value: 1, label: '1' },
  { value: 2, label: '2' },
  { value: 3, label: '3' },
  { value: 4, label: '4+ / Дом' },
]
const sorts = [
  { value: 'newest', label: 'По умолчанию' },
  { value: 'price_asc', label: 'Сначала дешевле' },
  { value: 'price_desc', label: 'Сначала дороже' },
  { value: 'area_asc', label: 'Площадь ↑' },
  { value: 'area_desc', label: 'Площадь ↓' },
]
const roomActive = (v: number) => (v === 4 ? (state.rooms ?? 0) >= 4 : state.rooms === v)
---

<Base
  title={`${head.title} — DUNE Real Estate`}
  description={head.sub}
  active={state.dir}
  companyPhone={settings.companyPhone}
  companyContact={settings.companyContact}
>
  <main id="main">
    <section class="page-head">
      <div class="container">
        <div class="crumbs">
          <a href="/">Главная</a><span>/</span>
          <a href="/catalog">Каталог</a><span>/</span>
          <span id="crumbDir" style="color:rgba(255,255,255,.85)">{head.crumb}</span>
        </div>
        <h1 id="pageTitle" set:html={head.titleHtml}></h1>
        <p class="page-head__sub" id="pageSub">{head.sub}</p>
      </div>
    </section>

    <section class="section--tight container">
      <div class="catalog">
        <!-- FILTERS -->
        <aside class="filters" id="filters">
          <div class="filters__head">
            <h3>Фильтры</h3>
            <button class="filters__reset" id="resetBtn" type="button">Сбросить</button>
            <button
              class="drawer__close hide-desktop"
              data-filters-close
              aria-label="Закрыть"
              style="border-color:var(--line);color:var(--ink)"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
          </div>

          <div class="fgroup" role="group" aria-label="Направление">
            <label>Направление</label>
            <div class="chips" id="dirChips">
              {dirChips.map((c) => (
                <button class:list={['chip', state.dir === c.key && 'is-on']} data-dir={c.key}>{c.label}</button>
              ))}
            </div>
          </div>

          <div class="fgroup" role="group" aria-label="Тип">
            <label>Тип объекта</label>
            <div class="chips" id="typeChips">
              {PROPERTY_TYPES.map((t) => (
                <button class:list={['chip', state.type === t.value && 'is-on']} data-type={t.value}>{t.label}</button>
              ))}
            </div>
          </div>

          <div class="fgroup" role="group" aria-label="Комнат">
            <label>Комнат</label>
            <div class="chips" id="roomChips">
              {roomChips.map((c) => (
                <button class:list={['chip', roomActive(c.value) && 'is-on']} data-rooms={c.value}>{c.label}</button>
              ))}
            </div>
          </div>

          <div class="fgroup" id="priceGroup" hidden={!priceOn}>
            <label id="priceLabel">{`Цена, ${priceCur}`}</label>
            <div class="frow">
              <input type="number" id="pmin" placeholder="от" min="0" step="100000" aria-label="Цена от" value={state.minPrice ?? ''} />
              <input type="number" id="pmax" placeholder="до" min="0" step="100000" aria-label="Цена до" value={state.maxPrice ?? ''} />
            </div>
          </div>

          <div class="fgroup">
            <label>Площадь, м²</label>
            <div class="frow">
              <input type="number" id="amin" placeholder="от" min="0" aria-label="Площадь от, м²" value={state.minArea ?? ''} />
              <input type="number" id="amax" placeholder="до" min="0" aria-label="Площадь до, м²" value={state.maxArea ?? ''} />
            </div>
          </div>

          <div class="fgroup">
            <label style="margin-bottom:6px">Условия</label>
            <label class="ftoggle"><span>Только с рассрочкой</span>
              <input type="checkbox" id="instToggle" checked={state.installment} /><span class="switch"></span></label>
            <label class="ftoggle"><span>Премиум-класс</span>
              <input type="checkbox" id="premToggle" checked={state.premium} /><span class="switch"></span></label>
            <label class="ftoggle"><span>Новостройки</span>
              <input type="checkbox" id="newToggle" checked={state.isNewBuilding} /><span class="switch"></span></label>
          </div>

          <button class="btn btn--primary btn--block filters__apply hide-desktop" data-filters-close type="button" style="margin-top:8px">
            Показать <span id="applyCount"></span>
          </button>
        </aside>

        <!-- MAIN -->
        <div class="catalog__main" id="catalogMain" data-page="1" data-pagecount={result.pageCount} data-total={result.total}>
          <div class="catalog__bar">
            <button class="btn btn--ghost btn--sm filters-mobile-btn" id="openFilters" type="button">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h16M7 12h10M10 18h4"></path></svg>
              Фильтры
            </button>
            <div class="catalog__count">Найдено <b id="resultCount">{result.total}</b></div>
            <div class="catalog__sort">
              <span class="muted hide-mobile" style="font-size:13px">Сортировка:</span>
              <select id="sortSel" aria-label="Сортировка">
                {sorts.map((s) => (
                  <option value={s.value} selected={state.sort === s.value}>{s.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="chips" id="activePills" style={pills.length ? 'margin-bottom:22px' : 'display:none'}>
            {pills.map((p) => (
              <button class="chip is-on" type="button" data-pill={p.key}>{p.label} <span style="margin-left:4px;font-weight:700">×</span></button>
            ))}
          </div>

          <div class="catalog__grid" id="catalogGrid" set:html={gridHtml}></div>

          <div class="center" id="showMoreWrap" style="margin-top:36px" hidden={!hasMore}>
            <button class="btn btn--ghost" id="showMore" type="button">Показать ещё</button>
          </div>

          <div class="catalog__empty" id="emptyState" hidden={result.total > 0}>
            <b>Ничего не найдено</b>
            <p class="muted">Попробуйте смягчить фильтры или сбросить их.</p>
            <button class="btn btn--ghost btn--sm" id="resetBtn2" type="button" style="margin-top:16px">Сбросить фильтры</button>
          </div>
        </div>
      </div>
    </section>

    <section class="section--tight" style="background:var(--bordo);color:#fff">
      <div class="container" style="display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap">
        <div>
          <h2 class="h2" style="color:#fff" set:html={'Не нашли <b style=\'color:var(--sand)\'>подходящее?</b>'}></h2>
          <p style="color:rgba(255,255,255,.75);margin-top:10px;max-width:46ch">Оставьте заявку — подберём объект под ваш бюджет и задачу из закрытой базы.</p>
        </div>
        <a class="btn btn--sand" href="/#contact">Получить подборку</a>
      </div>
    </section>
  </main>

  <script>
    import { initCatalog } from '../scripts/catalog'
    initCatalog()
  </script>
</Base>
