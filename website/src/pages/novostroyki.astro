---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getComplexFacets, getPublicSettings, listComplexes } from '../lib/api'
import { complexCardHtml } from '../lib/complexCard'
import { formatDelivery } from '../lib/format'

const params = Astro.url.searchParams
const sort = params.get('sort') ?? 'newest'
const city = (params.get('city') ?? '').trim()
const q = (params.get('q') ?? '').trim()
const premium = params.get('premium') === 'true'
const page = Math.max(1, Number(params.get('page') ?? '1') || 1)

const parseCsv = (key: string) =>
  (params.get(key) ?? '').split(',').map((s) => s.trim()).filter(Boolean)
const selectedFeatures = parseCsv('features')
const selectedDelivery = parseCsv('delivery')
const developer = (params.get('developer') ?? '').trim()
const priceMin = (params.get('priceMin') ?? '').trim()
const priceMax = (params.get('priceMax') ?? '').trim()

const [settings, facets, result] = await Promise.all([
  getPublicSettings(),
  getComplexFacets(),
  listComplexes({
    sort,
    city: city || undefined,
    q: q || undefined,
    premium: premium || undefined,
    features: selectedFeatures.length ? selectedFeatures : undefined,
    delivery: selectedDelivery.length ? selectedDelivery : undefined,
    developer: developer ? [developer] : undefined,
    priceMin: priceMin ? Number(priceMin) : undefined,
    priceMax: priceMax ? Number(priceMax) : undefined,
    page,
    limit: 24,
  }),
])

const hasFilters =
  q !== '' ||
  city !== '' ||
  premium ||
  developer !== '' ||
  selectedFeatures.length > 0 ||
  selectedDelivery.length > 0 ||
  priceMin !== '' ||
  priceMax !== ''

const gridHtml = result.items.map((c) => complexCardHtml(c)).join('')

const sorts = [
  { value: 'newest', label: 'По умолчанию' },
  { value: 'price_asc', label: 'Сначала дешевле' },
  { value: 'price_desc', label: 'Сначала дороже' },
  { value: 'name_asc', label: 'По названию' },
]

const countLabel = (() => {
  const n = result.total
  const mod10 = n % 10
  const mod100 = n % 100
  if (mod10 === 1 && mod100 !== 11) return `${n} жилой комплекс`
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return `${n} жилых комплекса`
  return `${n} жилых комплексов`
})()

function pageHref(p: number): string {
  const next = new URLSearchParams(params)
  next.set('page', String(p))
  return `/novostroyki?${next.toString()}`
}

// Numbered pager: always show first, last, current and its neighbours; collapse
// the rest into ellipsis gaps. Keeps the control compact as the catalog grows.
function pageItems(current: number, count: number): Array<number | 'gap'> {
  const wanted = new Set<number>([1, count, current, current - 1, current + 1])
  const visible = [...wanted].filter((p) => p >= 1 && p <= count).sort((a, b) => a - b)
  const items: Array<number | 'gap'> = []
  let prev = 0
  for (const p of visible) {
    if (prev && p - prev > 1) items.push('gap')
    items.push(p)
    prev = p
  }
  return items
}
---

<Base
  title="Новостройки — жилые комплексы | DUNE Real Estate"
  description="Каталог новостроек DUNE: жилые комплексы Грозного и Чеченской Республики — цены от застройщика, рассрочка, планировки."
  active="new"
  companyPhone={settings.companyPhone}
  companyContact={settings.companyContact}
>
  <main id="main">
    <section class="page-head">
      <div class="container">
        <div class="crumbs">
          <a href="/">Главная</a><span>/</span>
          <span class="crumbs__current">Новостройки</span>
        </div>
        <h1 set:html={'Жилые <b>комплексы</b>'}></h1>
        <p class="page-head__sub">Новостройки от застройщиков — выбирайте ЖК, смотрите планировки и условия рассрочки.</p>
      </div>
    </section>

    <section class="section--tight container">
      <form class="zhk-bar" method="get">
        <div class="zhk-search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
          <input
            class="zhk-search__input"
            type="search"
            name="q"
            value={q}
            placeholder="Поиск по ЖК, городу или застройщику"
            aria-label="Поиск по новостройкам"
          />
        </div>

        {facets.cities.length > 1 && (
          <select class="zhk-select" name="city" aria-label="Город" data-autosubmit>
            <option value="">Все города</option>
            {facets.cities.map((c) => (
              <option value={c.value} selected={city === c.value}>{c.value}</option>
            ))}
          </select>
        )}

        {facets.deliveries.length > 0 && (
          <details class="zhk-pop">
            <summary class="zhk-pop__btn">
              Срок сдачи{selectedDelivery.length > 0 ? ` · ${selectedDelivery.length}` : ''}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <div class="zhk-pop__panel">
              {facets.deliveries.map((d) => (
                <label class="zhk-pop__opt">
                  <input type="checkbox" data-multi="delivery" value={d.value} checked={selectedDelivery.includes(d.value)} />
                  <span>{formatDelivery(d.value)}</span><em>{d.count}</em>
                </label>
              ))}
            </div>
          </details>
        )}

        {facets.features.length > 0 && (
          <details class="zhk-pop">
            <summary class="zhk-pop__btn">
              Особенности{selectedFeatures.length > 0 ? ` · ${selectedFeatures.length}` : ''}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <div class="zhk-pop__panel zhk-pop__panel--wide">
              {facets.features.map((f) => (
                <label class="zhk-pop__opt">
                  <input type="checkbox" data-multi="features" value={f.value} checked={selectedFeatures.includes(f.value)} />
                  <span>{f.value}</span><em>{f.count}</em>
                </label>
              ))}
            </div>
          </details>
        )}

        <div class="zhk-price">
          <input type="number" class="zhk-price__in" name="priceMin" value={priceMin} min="0" step="1000" placeholder="₽/м² от" aria-label="Цена за м², от" />
          <span class="zhk-price__dash">—</span>
          <input type="number" class="zhk-price__in" name="priceMax" value={priceMax} min="0" step="1000" placeholder="до" aria-label="Цена за м², до" />
        </div>

        {facets.developers.length > 0 && (
          <select class="zhk-select" name="developer" aria-label="Застройщик" data-autosubmit>
            <option value="">Все застройщики</option>
            {facets.developers.map((d) => (
              <option value={d.value} selected={developer === d.value}>{d.value}</option>
            ))}
          </select>
        )}

        <label class="zhk-toggle">
          <input type="checkbox" name="premium" value="true" checked={premium} data-autosubmit />
          <span>Премиум</span>
        </label>

        <select class="zhk-select" name="sort" aria-label="Сортировка" data-autosubmit>
          {sorts.map((s) => (
            <option value={s.value} selected={sort === s.value}>{s.label}</option>
          ))}
        </select>

        {/* Hidden CSV mirrors of the multi-select popovers, kept in sync by the page script. */}
        <input type="hidden" name="features" value={selectedFeatures.join(',')} data-multi-field="features" />
        <input type="hidden" name="delivery" value={selectedDelivery.join(',')} data-multi-field="delivery" />

        <button class="btn btn--primary btn--sm" type="submit">Применить</button>
        {hasFilters && <a class="btn btn--ghost btn--sm" href="/novostroyki">Сбросить</a>}
      </form>

      <div class="catalog__count zhk-count">{countLabel}</div>

      {result.items.length > 0 ? (
        <div class="zhk-grid" set:html={gridHtml}></div>
      ) : hasFilters ? (
        <div class="catalog__empty">
          <b>Ничего не найдено</b>
          <p class="muted">
            {q || city
              ? `По запросу «${q || city}» нет жилых комплексов.`
              : 'По выбранным фильтрам нет жилых комплексов.'} Измените параметры или сбросьте фильтры.
          </p>
          <a class="btn btn--ghost btn--sm" href="/novostroyki">Сбросить фильтры</a>
        </div>
      ) : page > 1 ? (
        <div class="catalog__empty">
          <b>Страница пуста</b>
          <p class="muted">Похоже, такой страницы каталога нет. Вернитесь к началу списка.</p>
          <a class="btn btn--ghost btn--sm" href="/novostroyki">К началу каталога</a>
        </div>
      ) : (
        <div class="catalog__empty">
          <b>Пока нет опубликованных ЖК</b>
          <p class="muted">Комплексы появятся здесь, как только их добавят в каталог.</p>
          <a class="btn btn--ghost btn--sm" href="/#contact">Оставить заявку на подбор</a>
        </div>
      )}

      {result.pageCount > 1 && (
        <nav class="zhk-pager" aria-label="Страницы каталога">
          {page > 1 && (
            <a class="zhk-pager__btn" href={pageHref(page - 1)} rel="prev">Назад</a>
          )}
          {pageItems(page, result.pageCount).map((item) =>
            item === 'gap' ? (
              <span class="zhk-pager__gap" aria-hidden="true">…</span>
            ) : (
              <a
                class:list={['zhk-pager__num', item === page && 'is-on']}
                href={pageHref(item)}
                aria-current={item === page ? 'page' : undefined}
              >
                {item}
              </a>
            ),
          )}
          {page < result.pageCount && (
            <a class="zhk-pager__btn" href={pageHref(page + 1)} rel="next">Вперёд</a>
          )}
        </nav>
      )}
    </section>

    <section class="section--tight cta-band">
      <div class="container">
        <div>
          <h2 class="h2" set:html={'Не нашли <b>подходящий ЖК?</b>'}></h2>
          <p>Оставьте заявку — подберём новостройку под ваш бюджет и условия рассрочки.</p>
        </div>
        <a class="btn btn--sand" href="/#contact">Получить подборку</a>
      </div>
    </section>
  </main>
</Base>

<script>
  // The form carries no `page` field, so a GET submit rebuilds the query without
  // it and the result starts on page one.
  const form = document.querySelector<HTMLFormElement>('.zhk-bar')
  if (form) {
    // City / sort / premium / developer apply immediately on change. Search text
    // and the price range still apply on Enter or the "Применить" button.
    form.querySelectorAll<HTMLElement>('[data-autosubmit]').forEach((el) => {
      el.addEventListener('change', () => form.requestSubmit())
    })
    // Multi-select popovers (срок сдачи, особенности): mirror the checked values
    // into the hidden CSV field; applied together via "Применить" so picking
    // several options doesn't reload the page on every click.
    form.querySelectorAll<HTMLInputElement>('[data-multi]').forEach((box) => {
      box.addEventListener('change', () => {
        const name = box.dataset.multi
        const values = Array.from(
          form.querySelectorAll<HTMLInputElement>(`[data-multi="${name}"]:checked`),
        ).map((b) => b.value)
        const field = form.querySelector<HTMLInputElement>(`[data-multi-field="${name}"]`)
        if (field) field.value = values.join(',')
      })
    })
  }
</script>
