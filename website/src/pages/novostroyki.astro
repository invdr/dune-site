---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getPublicSettings, listComplexes } from '../lib/api'
import { complexCardHtml } from '../lib/complexCard'

const params = Astro.url.searchParams
const sort = params.get('sort') ?? 'newest'
const city = (params.get('city') ?? '').trim()
const q = (params.get('q') ?? '').trim()
const page = Math.max(1, Number(params.get('page') ?? '1') || 1)

const [settings, result] = await Promise.all([
  getPublicSettings(),
  listComplexes({ sort, city: city || undefined, q: q || undefined, page, limit: 24 }),
])

const hasFilters = q !== '' || city !== ''

const gridHtml = result.items.map((c) => complexCardHtml(c)).join('')

const sorts = [
  { value: 'newest', label: 'По умолчанию' },
  { value: 'price_asc', label: 'Сначала дешевле' },
  { value: 'price_desc', label: 'Сначала дороже' },
  { value: 'name_asc', label: 'По названию' },
]

const countLabel = (() => {
  const n = result.total
  const mod10 = n % 10
  const mod100 = n % 100
  if (mod10 === 1 && mod100 !== 11) return `${n} жилой комплекс`
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return `${n} жилых комплекса`
  return `${n} жилых комплексов`
})()

function pageHref(p: number): string {
  const next = new URLSearchParams(params)
  next.set('page', String(p))
  return `/novostroyki?${next.toString()}`
}

// Numbered pager: always show first, last, current and its neighbours; collapse
// the rest into ellipsis gaps. Keeps the control compact as the catalog grows.
function pageItems(current: number, count: number): Array<number | 'gap'> {
  const wanted = new Set<number>([1, count, current, current - 1, current + 1])
  const visible = [...wanted].filter((p) => p >= 1 && p <= count).sort((a, b) => a - b)
  const items: Array<number | 'gap'> = []
  let prev = 0
  for (const p of visible) {
    if (prev && p - prev > 1) items.push('gap')
    items.push(p)
    prev = p
  }
  return items
}
---

<Base
  title="Новостройки — жилые комплексы | DUNE Real Estate"
  description="Каталог новостроек DUNE: жилые комплексы Грозного и Чеченской Республики — цены от застройщика, рассрочка, планировки."
  active="new"
  companyPhone={settings.companyPhone}
  companyContact={settings.companyContact}
>
  <main id="main">
    <section class="page-head">
      <div class="container">
        <div class="crumbs">
          <a href="/">Главная</a><span>/</span>
          <span class="crumbs__current">Новостройки</span>
        </div>
        <h1 set:html={'Жилые <b>комплексы</b>'}></h1>
        <p class="page-head__sub">Новостройки от застройщиков — выбирайте ЖК, смотрите планировки и условия рассрочки.</p>
      </div>
    </section>

    <section class="section--tight container">
      <form class="zhk-bar" method="get">
        <div class="zhk-search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
          <input
            class="zhk-search__input"
            type="search"
            name="q"
            value={q}
            placeholder="Поиск по ЖК, городу или застройщику"
            aria-label="Поиск по новостройкам"
          />
        </div>
        {city && <input type="hidden" name="city" value={city} />}
        <div class="zhk-sort">
          <label class="muted hide-mobile" for="zhkSort">Сортировка:</label>
          <select id="zhkSort" name="sort">
            {sorts.map((s) => (
              <option value={s.value} selected={sort === s.value}>{s.label}</option>
            ))}
          </select>
        </div>
        <button class="btn btn--primary btn--sm" type="submit">Применить</button>
        {hasFilters && <a class="btn btn--ghost btn--sm" href="/novostroyki">Сбросить</a>}
      </form>

      <div class="catalog__count zhk-count">{countLabel}</div>

      {result.total > 0 ? (
        <div class="zhk-grid" set:html={gridHtml}></div>
      ) : hasFilters ? (
        <div class="catalog__empty">
          <b>Ничего не найдено</b>
          <p class="muted">По запросу «{q || city}» нет жилых комплексов. Измените запрос или сбросьте фильтры.</p>
          <a class="btn btn--ghost btn--sm" href="/novostroyki">Сбросить фильтры</a>
        </div>
      ) : (
        <div class="catalog__empty">
          <b>Пока нет опубликованных ЖК</b>
          <p class="muted">Комплексы появятся здесь, как только их добавят в каталог.</p>
          <a class="btn btn--ghost btn--sm" href="/#contact">Оставить заявку на подбор</a>
        </div>
      )}

      {result.pageCount > 1 && (
        <nav class="zhk-pager" aria-label="Страницы каталога">
          {page > 1 && (
            <a class="zhk-pager__btn" href={pageHref(page - 1)} rel="prev">Назад</a>
          )}
          {pageItems(page, result.pageCount).map((item) =>
            item === 'gap' ? (
              <span class="zhk-pager__gap" aria-hidden="true">…</span>
            ) : (
              <a
                class:list={['zhk-pager__num', item === page && 'is-on']}
                href={pageHref(item)}
                aria-current={item === page ? 'page' : undefined}
              >
                {item}
              </a>
            ),
          )}
          {page < result.pageCount && (
            <a class="zhk-pager__btn" href={pageHref(page + 1)} rel="next">Вперёд</a>
          )}
        </nav>
      )}
    </section>

    <section class="section--tight cta-band">
      <div class="container">
        <div>
          <h2 class="h2" set:html={'Не нашли <b>подходящий ЖК?</b>'}></h2>
          <p>Оставьте заявку — подберём новостройку под ваш бюджет и условия рассрочки.</p>
        </div>
        <a class="btn btn--sand" href="/#contact">Получить подборку</a>
      </div>
    </section>
  </main>
</Base>
