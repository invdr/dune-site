---
// DUNE wordmark + dune/key glyph. `markWidth` lets the footer use a smaller
// mark; everything else matches the design reference exactly.
interface Props {
  markWidth?: string
  class?: string
}
const { markWidth, class: className } = Astro.props
const markStyle = markWidth ? `width:${markWidth}` : undefined
---

<a class:list={['brand', className]} href="/" aria-label="DUNE Real Estate">
  <svg class="brand__mark" viewBox="0 0 232 130" fill="currentColor" aria-hidden="true" style={markStyle}>
    <path
      fill-rule="evenodd"
      d="M40 35 L46 59 L70 65 L46 71 L40 95 L34 71 L10 65 L34 59 Z M84 30 L84 100 L112 100 A35 35 0 0 0 112 30 Z M108 48 a17 17 0 1 0 0.1 0 Z"
    ></path>
    <rect x="140" y="60" width="78" height="10" rx="2"></rect>
    <rect x="196" y="70" width="9" height="13" rx="1.5"></rect>
    <rect x="210" y="70" width="9" height="11" rx="1.5"></rect>
  </svg>
  <span class="brand__name"><span class="brand__word">DUNE</span><span class="brand__sub">REAL ESTATE</span></span>
</a>
