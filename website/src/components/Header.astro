---
import Brand from './Brand.astro'

// `active` highlights the matching nav item. `phone` defaults to the agency's
// public number (overridable once a real number is wired from settings).
interface Props {
  active?: 'home' | 'new' | 'resale' | 'dubai' | 'saudi' | 'install' | null
  phone?: string
}
const { active = null, phone = '+7 928 000-00-00' } = Astro.props
const telHref = `tel:${phone.replace(/[^+\d]/g, '')}`

const nav = [
  { key: 'home', label: 'Главная', href: '/' },
  { key: 'new', label: 'Новостройки', href: '/novostroyki' },
  { key: 'resale', label: 'Вторичка', href: '/catalog?dir=resale' },
  { key: 'dubai', label: 'Дубай', href: '/catalog?dir=dubai' },
  { key: 'saudi', label: 'Саудовская Аравия', href: '/catalog?dir=saudi' },
  { key: 'install', label: 'Рассрочка', href: '/#install' },
] as const
---

<header class="site-header">
  <div class="container site-header__top">
    <Brand />
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href} class={active === item.key ? 'is-active' : undefined} data-nav={item.key}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="header-fav" href="/favorites" aria-label="Избранное">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>
        <span class="header-fav__count" data-fav-count hidden>0</span>
      </a>
      <div class="header-phone"><a href={telHref}>{phone}</a><span>Грозный</span></div>
      <a class="header-call" href={telHref} aria-label="Позвонить">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>
      </a>
      <a class="btn btn--sand btn--sm hide-mobile" href="/#contact">Оставить заявку</a>
      <button class="burger" data-burger aria-label="Открыть меню">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer" data-drawer>
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      <Brand size="sm" />
      <button class="drawer__close" data-drawer-close aria-label="Закрыть">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <nav class="drawer__nav">
      <a class="dlink" href="/novostroyki"><i class="dlink__n">01</i><span class="dlink__t">Новостройки</span><svg class="dlink__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      <a class="dlink" href="/catalog?dir=resale"><i class="dlink__n">02</i><span class="dlink__t">Вторичка</span><svg class="dlink__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      <a class="dlink" href="/catalog?dir=dubai"><i class="dlink__n">03</i><span class="dlink__t">Дубай</span><svg class="dlink__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      <a class="dlink" href="/catalog?dir=saudi"><i class="dlink__n">04</i><span class="dlink__t">Саудовская Аравия</span><svg class="dlink__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </nav>

    <div class="drawer__sub">
      <a href="/favorites">Избранное</a>
      <a href="/#install">Рассрочка</a>
      <a href="/#contact">Контакты</a>
    </div>

    <div class="drawer__foot">
      <a class="btn btn--sand btn--block drawer__cta" href="/#contact">Оставить заявку</a>
      <a class="drawer__phone" href={telHref}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>
        <span>{phone}</span>
      </a>
      <div class="drawer__hours">Грозный, ежедневно с 9:00 до 20:00</div>
    </div>
  </div>
</div>
