---
import '../styles/dune.css'
import '../styles/components.css'
import '../styles/site.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  active?: 'home' | 'new' | 'resale' | 'dubai' | 'saudi' | 'install' | null
  image?: string
  canonical?: string
  skipTarget?: string
  companyPhone?: string | null
  companyContact?: string | null
}

const {
  title,
  description,
  active = null,
  image = '/assets/og-cover.jpg',
  canonical,
  skipTarget = '#main',
  companyPhone,
  companyContact,
} = Astro.props

const siteOrigin = Astro.site?.origin ?? 'https://dunestate.ru'
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteOrigin).href
const imageUrl = image.startsWith('http') ? image : new URL(image, siteOrigin).href
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DUNE Real Estate" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href={skipTarget}>К содержимому</a>
    <Header active={active} phone={companyPhone ?? undefined} />
    <slot />
    <Footer companyPhone={companyPhone} companyContact={companyContact} />

    <script>
      import { initChrome } from '../scripts/ui'
      import { initFavorites } from '../scripts/favorites'
      import { initLeadForms } from '../scripts/leadForm'

      initChrome()
      initFavorites()
      initLeadForms()
    </script>
  </body>
</html>
