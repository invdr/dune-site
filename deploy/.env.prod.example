# Copy to deploy/.env.prod on the VPS and fill in real values. Never commit .env.prod.
# Used both for docker compose variable interpolation (--env-file) and as the
# backend/caddy container environment (env_file).

# --- Domains (point each DNS A-record at the VPS IP before first `up`) ---
WEBSITE_DOMAIN=example.com
WEBAPP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# --- Build-time public config baked into the static bundles ---
# Must match API_DOMAIN / WEBAPP_DOMAIN above. Rebuild the caddy image after changes.
VITE_API_URL=https://api.example.com
PUBLIC_WEBAPP_URL=https://app.example.com

# --- PostgreSQL (internal to the compose network) ---
POSTGRES_DB=web_app_demo
POSTGRES_USER=app
# Use a long random password, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# --- Backend runtime ---
# Generate with: openssl rand -hex 32  (at least 32 random bytes)
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
# Exact browser origins that call the API with credentials. No wildcards, no paths.
CORS_ORIGINS=https://app.example.com,https://example.com
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS); the backend rejects HTTP origins when true.
COOKIE_SECURE=true

# --- Optional S3-compatible object storage (uploads/media) ---
# Leave blank unless the product needs uploads. Works with any S3-compatible
# provider (e.g. self-hosted MinIO on the VPS, or an external object store).
SPACES_REGION=
SPACES_BUCKET=
SPACES_ENDPOINT=
SPACES_CDN_BASE_URL=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_UPLOAD_MAX_BYTES=10485760
SPACES_UPLOAD_URL_TTL_SECONDS=900
SPACES_DOWNLOAD_URL_TTL_SECONDS=300
SPACES_PUBLIC_CACHE_CONTROL=public, max-age=31536000, immutable
